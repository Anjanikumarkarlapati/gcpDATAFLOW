{
  "displayName": "Clickstream: dead-letter volume",
  "combiner": "OR",
  "documentation": {
    "content": "Dead-letter events/sec above threshold (target <1% of traffic). Verify the metric name in Metrics Explorer for your job; inspect clickstream.dead_letters.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "Clickstream: dead-letter volume",
      "conditionThreshold": {
