{
  "displayName": "Clickstream: Pub/Sub backlog high",
  "combiner": "OR",
  "documentation": {
    "content": "Backlog growing: check Dataflow autoscaling / worker errors. See docs/RUNBOOK.md.",
    "mimeType": "text/markdown"
  },
  "conditions": [
    {
      "displayName": "Clickstream: Pub/Sub backlog high",
      "conditionThreshold": {
        "filter": "metric.type=\"pubsub.googleapis.com/subscription/num_undelivered_messages\" resource.type=\"pubsub_subscription\" resource.label.\"subscription_id\"=\"clickstream-sub\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 100000,
        "duration": "300s",
        "aggregations": [
          {
            "alignmentPeriod": "60s",
            "perSeriesAligner": "ALIGN_MEAN"
          }
        ]
      }
    }
  ]
}
